# Copy to backend/.env on the server (chmod 600). Never commit it.
SECRET_KEY=<run: python3 -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=False
# One domain for the app and the API (api is also reached as http://api:8000 inside docker)
ALLOWED_HOSTS=twv.prowavetech.in,api,localhost
CSRF_TRUSTED_ORIGINS=https://twv.prowavetech.in
CORS_ALLOWED_ORIGINS=https://twv.prowavetech.in
FRONTEND_URL=https://twv.prowavetech.in

# Database (the db container reads the POSTGRES_* lines; the API reads DATABASE_URL)
POSTGRES_USER=twv
POSTGRES_PASSWORD=<a long random password>
POSTGRES_DB=twv
DATABASE_URL=postgres://twv:<same password>@db:5432/twv

# Uploads stay on the server disk (docker volume "media") and the API serves them
SERVE_MEDIA=True

# Email (Gmail: turn on 2-step verification, then make an App password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=<16-letter app password>
DEFAULT_FROM_EMAIL=Train With Vimal <you@gmail.com>

# Push (Firebase): see deploy/README.md → Firebase. Keep console until the JSON file is in secrets/
PUSH_PROVIDER=console
FCM_PROJECT_ID=<firebase project id>
FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json

# WhatsApp: later
WHATSAPP_PROVIDER=console
