# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://twv:twv@localhost:5432/twv
# Leave REDIS_URL empty to run without Redis (dev only: no scheduled reminders)
REDIS_URL=redis://localhost:6379/0
CHANNELS_REDIS_URL=redis://localhost:6379/2
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Kolkata

# Email (console prints emails in the terminal; use smtp for real sending)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Train With Vimal <hello@trainwithvimal.com>

# Push: console (logs only) or fcm (needs a Firebase service-account JSON file)
# Push (D-56). console = only printed. For real pushes: fcm + the Firebase project id + the service-account file
# saved as backend/secrets/firebase-service-account.json (the secrets folder is not in git).
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# WhatsApp: console for now (later: meta)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
